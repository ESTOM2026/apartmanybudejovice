---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import EbikeCallout from '../../components/EbikeCallout.astro';
import B2BSection from '../../components/B2BSection.astro';
import HomeSections from '../../components/HomeSections.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { useTranslations } from '../../i18n/utils';
import { getRoute } from '../../i18n/routes';

const lang = 'en';
const t = useTranslations(lang);
---
<BaseLayout
  pageKey="home"
  title="Apartment rental České Budějovice – from CZK 1,200/night"
  description="Family apartment for rent in České Budějovice – 70 m² (2+1), full kitchen, free parking. Ideal for families and corporate stays. From CZK 1,200/night."
>
  <Hero />
  <Features />
  <EbikeCallout />
  <B2BSection />

  <HomeSections />

  <ReviewsSection />

  <section class="py-20 md:py-24">
    <div class="container-narrow text-center">
      <h2 class="text-3xl md:text-4xl font-medium mb-5">{t('contact.title')}</h2>
      <p class="text-lg text-[var(--color-ink-soft)] max-w-xl mx-auto mb-8">{t('contact.lead')}</p>
      <a href={getRoute('contact', lang)} class="btn-primary">
        {t('cta.inquire')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
