---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

// Booking availability notice. Change / remove here when the situation changes.
const text = {
  cs: '14. 10. – 31. 12. 2026 obsazeno · volné termíny od ledna 2027',
  en: 'Fully booked 14 Oct – 31 Dec 2026 · available from January 2027',
  de: '14. 10. – 31. 12. 2026 ausgebucht · frei ab Januar 2027',
}[lang];

// After this moment the notice is stale: skipped at build time, and hidden
// in the browser too in case the site isn't rebuilt right away.
const until = '2027-01-01T00:00:00+01:00';
const expired = Date.now() >= new Date(until).getTime();
---
{!expired && (
<div class="booked" role="status" data-nosnippet data-until={until}>
  <div class="booked__tape">
    <svg class="booked__icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2 1 21h22L12 2Zm0 6a1 1 0 0 1 1 1v5a1 1 0 1 1-2 0V9a1 1 0 0 1 1-1Zm0 9a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z" />
    </svg>
    <span>{text}</span>
  </div>
</div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.booked[data-until]').forEach((el) => {
    if (Date.now() >= new Date(el.dataset.until!).getTime()) el.remove();
  });
</script>

<style>
  /* Normal-flow band: reserves its own vertical space and pushes the hero
     content down, so the tilted tape stays bold but never hides the headline. */
  .booked {
    position: relative;
    z-index: 30;
    display: flex;
    justify-content: center;
    overflow: hidden;            /* clip the tilted corners that bleed off-screen */
    padding-top: 0;              /* flush under the header — no gap above */
    padding-bottom: 0;
    /* Pull the hero content up so the band sits right above the "Rodinný
       apartmán" eyebrow, cancelling the hero's own top padding. */
    margin-bottom: -2.5rem;
  }
  .booked__tape {
    flex: none;
    width: 106%;                 /* just past both edges so the tilt reaches the corners */
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    transform: rotate(-6deg);
    background: var(--color-lego-red);
    color: #fff;
    padding: 1.55rem 1.25rem;   /* generous vertical room so the tilted text is never clipped */
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    line-height: 1.25;
    text-align: center;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }
  .booked__icon { flex: none; opacity: 0.95; }

  @media (min-width: 768px) {
    .booked { margin-bottom: -4.25rem; }
    .booked__tape {
      width: 108%;
      font-size: 1.15rem;
      padding: 1.9rem 1.5rem;
      gap: 0.7rem;
    }
  }
</style>
