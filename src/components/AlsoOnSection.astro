---
import { getLangFromUrl } from '../i18n/utils';
import { getRoute } from '../i18n/routes';
import { bookingUrl, airbnbUrl } from '../i18n/booking';

const lang = getLangFromUrl(Astro.url);

// Booking.com / Airbnb as trust signals and alternative channels — deliberately
// low-key so they don't compete with the main "check dates & price" CTA.
const t = {
  cs: {
    heading: 'Najdete nás také na Booking.com a Airbnb',
    text: 'Lets Go Family Apartment si můžete rezervovat přímo u nás, nebo přes Booking.com a Airbnb. Plánujete delší, pracovní nebo studijní pobyt? Napište nám napřímo — připravíme individuální nabídku.',
    direct: 'Napsat napřímo',
    newTab: '(otevře se v novém okně)',
  },
  en: {
    heading: 'You can also find us on Booking.com and Airbnb',
    text: 'You can book Lets Go Family Apartment directly with us, or via Booking.com and Airbnb. Planning a longer, work or study stay? Contact us directly and we will prepare a tailored offer.',
    direct: 'Contact us directly',
    newTab: '(opens in a new tab)',
  },
  de: {
    heading: 'Sie finden uns auch auf Booking.com und Airbnb',
    text: 'Sie können Lets Go Family Apartment direkt bei uns buchen oder über Booking.com und Airbnb. Planen Sie einen längeren Arbeits‑ oder Studienaufenthalt? Schreiben Sie uns direkt — wir erstellen ein individuelles Angebot.',
    direct: 'Direkt anfragen',
    newTab: '(öffnet in neuem Tab)',
  },
}[lang];
---
<section class="py-10 md:py-12 border-t border-[var(--color-line)]">
  <div class="container-narrow text-center">
    <h2 class="text-2xl md:text-3xl font-medium mb-3">{t.heading}</h2>
    <p class="text-[var(--color-ink-soft)] leading-relaxed max-w-2xl mx-auto mb-6">{t.text}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href={bookingUrl(lang)} target="_blank" rel="noopener" class="btn-ghost">
        Booking.com<span class="sr-only"> {t.newTab}</span>
      </a>
      <a href={airbnbUrl} target="_blank" rel="noopener" class="btn-ghost">
        Airbnb<span class="sr-only"> {t.newTab}</span>
      </a>
      <a href={getRoute('contact', lang)} class="btn-ghost">{t.direct}</a>
    </div>
  </div>
</section>
