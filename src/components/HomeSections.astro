---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const t = {
  cs: {
    altLabel: 'Levné ubytování v Českých Budějovicích',
    altTitle: 'Apartmán jako alternativa penzionu, hotelu nebo bytu k pronájmu',
    altLead: 'Hledáte <strong>levné ubytování v Českých Budějovicích</strong>? Apartmán Lets Go nabízí komfort vlastního bytu za cenu penzionu — ideální volba pro rodiny, firmy, stážisty i hosty na <strong>dlouhodobý pronájem</strong>.',
    altCard1Title: 'Apartmán místo penzionu',
    altCard1Text: 'Soukromí celého bytu, vlastní kuchyň a koupelna. Žádné sdílené prostory ani snídaňové časy jako v <strong>penzionu v Budějovicích</strong>.',
    altCard2Title: 'Levnější než hotel',
    altCard2Text: 'Za cenu jednoho hotelového pokoje dostanete kompletní <strong>byt 2+1 k pronájmu</strong> pro 3–6 hostů. Výhoda pro rodiny i firmy.',
    altCard3Title: 'Krátkodobý i dlouhodobý pronájem',
    altCard3Text: 'Víkend, týden, měsíc nebo i déle. <strong>Dlouhodobé ubytování v Českých Budějovicích</strong> za zvýhodněnou cenu — ideální pro stážisty a zaměstnance.',
    legoLabel: 'Pro milovníky LEGA',
    legoTitle: 'LEGO koutek<br/>k prohlížení i ke koupi',
    legoLead: 'V apartmánu najdete část naší LEGO sbírky — exponáty průběžně obměňujeme. Příjemný bonus pro milovníky stavebnice.',
    legoF1Title: 'Vybrané modely na prodej',
    legoF1Text: 'Některé exponáty si lze odkoupit přímo od nás.',
    legoF2Title: 'LEGO na přání',
    legoF2Text: 'Hledáte konkrétní sadu? Můžeme ji pro vás sehnat.',
    legoCta: 'Zeptat se na LEGO',
    contactRoute: '/kontakt',
  },
  en: {
    altLabel: 'Affordable accommodation in České Budějovice',
    altTitle: 'Apartment as an alternative to a guesthouse, hotel or rental flat',
    altLead: 'Looking for <strong>affordable accommodation in České Budějovice</strong>? Lets Go Apartment offers the comfort of a private flat for the price of a guesthouse — ideal for families, companies, interns and <strong>long-term guests</strong>.',
    altCard1Title: 'Apartment instead of a guesthouse',
    altCard1Text: 'Privacy of the whole flat, your own kitchen and bathroom. No shared spaces or breakfast schedules like a <strong>guesthouse in Budějovice</strong>.',
    altCard2Title: 'Cheaper than a hotel',
    altCard2Text: 'For the price of a single hotel room you get a full <strong>2+1 flat for rent</strong> for 3–6 guests. Great for families and businesses.',
    altCard3Title: 'Short and long-term stays',
    altCard3Text: 'A weekend, a week, a month or longer. <strong>Long-term accommodation in České Budějovice</strong> at a discounted rate — ideal for interns and employees.',
    legoLabel: 'For LEGO lovers',
    legoTitle: 'LEGO corner<br/>to view and to buy',
    legoLead: 'In the apartment you will find part of our LEGO collection — exhibits rotate over time. A nice bonus for fans of the bricks.',
    legoF1Title: 'Selected models for sale',
    legoF1Text: 'Some of the displayed sets can be purchased directly from us.',
    legoF2Title: 'LEGO on request',
    legoF2Text: 'Looking for a specific set? We can source it for you.',
    legoCta: 'Ask about LEGO',
    contactRoute: '/en/contact',
  },
  de: {
    altLabel: 'Günstige Unterkunft in Budweis',
    altTitle: 'Apartment als Alternative zu Pension, Hotel oder Mietwohnung',
    altLead: 'Suchen Sie <strong>günstige Unterkunft in Budweis</strong>? Lets Go Apartment bietet den Komfort einer eigenen Wohnung zum Pensionspreis — ideal für Familien, Firmen, Praktikanten und Gäste auf <strong>Langzeitaufenthalt</strong>.',
    altCard1Title: 'Apartment statt Pension',
    altCard1Text: 'Privatsphäre einer ganzen Wohnung, eigene Küche und Bad. Keine Gemeinschaftsräume oder Frühstückszeiten wie in einer <strong>Pension in Budweis</strong>.',
    altCard2Title: 'Günstiger als ein Hotel',
    altCard2Text: 'Zum Preis eines Hotelzimmers erhalten Sie eine komplette <strong>2-Zimmer-Wohnung zur Miete</strong> für 3–6 Gäste. Vorteil für Familien und Firmen.',
    altCard3Title: 'Kurz- und Langzeitmiete',
    altCard3Text: 'Wochenende, Woche, Monat oder länger. <strong>Langzeitunterkunft in Budweis</strong> zum Vorzugspreis — ideal für Praktikanten und Mitarbeiter.',
    legoLabel: 'Für LEGO-Liebhaber',
    legoTitle: 'LEGO-Ecke<br/>zum Ansehen und Kaufen',
    legoLead: 'Im Apartment finden Sie einen Teil unserer LEGO-Sammlung — Exponate wechseln gelegentlich. Ein schöner Bonus für Fans der Bausteine.',
    legoF1Title: 'Ausgewählte Modelle zum Verkauf',
    legoF1Text: 'Einige der ausgestellten Modelle können direkt bei uns gekauft werden.',
    legoF2Title: 'LEGO auf Wunsch',
    legoF2Text: 'Suchen Sie ein bestimmtes Set? Wir besorgen es gerne für Sie.',
    legoCta: 'Nach LEGO fragen',
    contactRoute: '/de/kontakt',
  },
}[lang];
---
<section class="py-16 md:py-20 bg-[#fffbe6]">
  <div class="container-wide">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <span class="inline-block text-xs uppercase tracking-[0.2em] mb-4 font-semibold" style="color: var(--color-lego-blue);">
        {t.altLabel}
      </span>
      <h2 class="text-3xl md:text-4xl font-medium mb-5 leading-tight">
        {t.altTitle}
      </h2>
      <p class="text-lg text-[var(--color-ink-soft)] leading-relaxed" set:html={t.altLead}></p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="bg-white rounded-2xl p-7 border border-[var(--color-line)]">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: var(--color-lego-yellow);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <h3 class="text-xl font-display font-medium mb-2">{t.altCard1Title}</h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed" set:html={t.altCard1Text}></p>
      </div>

      <div class="bg-white rounded-2xl p-7 border border-[var(--color-line)]">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: var(--color-lego-red);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3 class="text-xl font-display font-medium mb-2">{t.altCard2Title}</h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed" set:html={t.altCard2Text}></p>
      </div>

      <div class="bg-white rounded-2xl p-7 border border-[var(--color-line)]">
        <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: var(--color-lego-blue);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h3 class="text-xl font-display font-medium mb-2">{t.altCard3Title}</h3>
        <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed" set:html={t.altCard3Text}></p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 md:py-20 relative overflow-hidden" style="background: linear-gradient(135deg, #fff 0%, #fffbe6 50%, #fff 100%);">
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='80' viewBox='0 0 80 80'><circle cx='20' cy='20' r='10' fill='%23000'/><circle cx='60' cy='20' r='10' fill='%23000'/><circle cx='20' cy='60' r='10' fill='%23000'/><circle cx='60' cy='60' r='10' fill='%23000'/></svg>&quot;); background-size: 80px 80px;"></div>

  <div class="container-wide relative">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] mb-5 font-semibold" style="color: var(--color-lego-red);">
          <span class="inline-block w-2 h-2 rounded-full" style="background: var(--color-lego-yellow);"></span>
          <span class="inline-block w-2 h-2 rounded-full" style="background: var(--color-lego-red);"></span>
          <span class="inline-block w-2 h-2 rounded-full" style="background: var(--color-lego-blue);"></span>
          {t.legoLabel}
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium mb-6 leading-tight" set:html={t.legoTitle}></h2>
        <p class="text-lg text-[var(--color-ink-soft)] mb-5 leading-relaxed">{t.legoLead}</p>
        <div class="space-y-4 mb-8">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style="background: var(--color-lego-yellow);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7l-8 4-8-4"/><path d="M20 7v10l-8 4-8-4V7"/><path d="M12 11v10"/></svg>
            </div>
            <div>
              <h3 class="font-display font-medium mb-1">{t.legoF1Title}</h3>
              <p class="text-sm text-[var(--color-ink-soft)]">{t.legoF1Text}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style="background: var(--color-lego-red);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </div>
            <div>
              <h3 class="font-display font-medium mb-1">{t.legoF2Title}</h3>
              <p class="text-sm text-[var(--color-ink-soft)]">{t.legoF2Text}</p>
            </div>
          </div>
        </div>
        <a href={t.contactRoute} class="btn-primary">
          {t.legoCta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="relative">
        <div class="grid grid-cols-2 gap-3 rounded-2xl overflow-hidden shadow-2xl shadow-black/10 aspect-square">
          <div class="relative overflow-hidden">
            <picture>
              <source srcset="/images/gallery/02.webp" type="image/webp" />
              <img src="/images/gallery/02.jpg" alt="LEGO" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="relative overflow-hidden">
            <picture>
              <source srcset="/images/gallery/13.webp" type="image/webp" />
              <img src="/images/gallery/13.jpg" alt="LEGO" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="relative overflow-hidden col-span-2">
            <picture>
              <source srcset="/images/gallery/14.webp" type="image/webp" />
              <img src="/images/gallery/14.jpg" alt="LEGO" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
