---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getRoute } from '../i18n/routes';
import LegoBrick from './LegoBrick.astro';
import { bookingUrl, airbnbUrl } from '../i18n/booking';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const privacyLabel = lang === 'cs' ? 'Zásady ochrany osobních údajů' : lang === 'en' ? 'Privacy Policy' : 'Datenschutz';
const cookieLabel = lang === 'cs' ? 'Nastavení cookies' : lang === 'en' ? 'Cookie settings' : 'Cookie-Einstellungen';
const alsoOn =lang === 'cs' ? 'Najdete nás také na' : lang === 'en' ? 'Also on' : 'Auch auf';
const creditPrefix =lang === 'cs' ? 'Web vytvořila agentura' : lang === 'en' ? 'Website by' : 'Website von';
---
<footer class="mt-10 border-t border-[var(--color-line)] bg-white">
  <div class="container-wide py-8 grid gap-8 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5 font-display text-lg mb-2">
        <LegoBrick size={32} color="var(--color-lego-red)" />
        <span class="font-semibold">Lets Go Apartment</span>
      </div>
      <p class="text-sm text-[var(--color-ink-soft)] max-w-xs">{t('footer.tagline')}</p>
    </div>

    <div>
      <h3 class="text-sm uppercase tracking-wider text-[var(--color-muted)] mb-3 font-sans font-semibold">{t('footer.links')}</h3>
      <ul class="space-y-2 text-sm">
        <li><a href={getRoute('apartment', lang)} class="hover:text-[var(--color-cta)]">{t('nav.apartment')}</a></li>
        <li><a href={getRoute('business', lang)} class="hover:text-[var(--color-cta)]">{t('nav.business')}</a></li>
        <li><a href={getRoute('longstay', lang)} class="hover:text-[var(--color-cta)]">{t('nav.longstay')}</a></li>
        <li><a href={getRoute('about', lang)} class="hover:text-[var(--color-cta)]">{t('nav.about')}</a></li>
        <li><a href={getRoute('contact', lang)} class="hover:text-[var(--color-cta)]">{t('nav.contact')}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-sm uppercase tracking-wider text-[var(--color-muted)] mb-3 font-sans font-semibold">{t('footer.contact')}</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="mailto:info@estom.cz" class="hover:text-[var(--color-cta)]">info@estom.cz</a></li>
        <li><a href="tel:+420777925594" class="hover:text-[var(--color-cta)]">+420 777 925 594</a></li>
        <li class="text-[var(--color-muted)]">I. Olbrachta 910/34, 370 06 České Budějovice</li>
      </ul>
      <p class="mt-4 text-sm text-[var(--color-muted)]">
        {alsoOn}
        <a href={bookingUrl(lang)} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--color-cta)]">Booking.com</a>
        ·
        <a href={airbnbUrl} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-[var(--color-cta)]">Airbnb</a>
      </p>
    </div>
  </div>

  <div class="border-t border-[var(--color-line)]">
    <div class="container-wide py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--color-muted)]">
      <span>© {year} Apartmány České Budějovice. {t('footer.rights')}</span>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
        <a href={getRoute('privacy', lang)} class="hover:text-[var(--color-cta)]">{privacyLabel}</a>
        <button type="button" data-cookie-settings class="hover:text-[var(--color-cta)]">{cookieLabel}</button>
        <span class="inline-flex items-center gap-1.5">{creditPrefix} <a href="https://webzavasicenu.cz" target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-[var(--color-cta)]"><img src="/webzavasicenu-logo.svg" width="14" height="14" alt="" aria-hidden="true" class="rounded-[3px]" /><span class="underline underline-offset-2">webzavasicenu.cz</span></a></span>
        <span>{t('about.languages')}</span>
      </div>
    </div>
  </div>
</footer>
